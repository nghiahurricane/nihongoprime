rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vocabularies/{docId} {
      allow read, write: if request.auth != null;
    }

    match /suggestions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Rule cũ (giữ lại phòng hờ app cũ chưa kịp update PWA)
      match /progress/{vocabId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // THÊM MỚI: Cấp quyền cho file gộp progressMap
      match /progressMap/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // THÊM MỚI: Cấp quyền cho file gộp quizStatsMap
      match /quizStatsMap/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily quest progress lives here: users/{uid}/dailyQuests/{yyyy-mm-dd}
      match /dailyQuests/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
    }
  }
}